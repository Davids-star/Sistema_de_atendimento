# Copie para .env e preencha. NUNCA commite o .env.
DATABASE_URL=postgresql+psycopg://barbearia_user:TROQUE_A_SENHA@localhost:5435/barbearia
SECRET_KEY=TROQUE_POR_UMA_CHAVE_ALEATORIA_LONGA
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
# WhatsApp (usado só na Etapa 9)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# Segurança / infraestrutura
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Opcional: banco separado só para testes (veja o README de testes)
# TEST_DATABASE_URL=postgresql+psycopg://barbearia_user:SENHA@localhost:5435/barbearia_test

# Login com Google (opcional). Crie um "ID do cliente OAuth" do tipo Aplicativo da Web no Google Cloud Console.
GOOGLE_CLIENT_ID=
