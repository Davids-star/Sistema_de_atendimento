# Copie para .env e preencha. NUNCA commite o .env.
DATABASE_URL=postgresql+psycopg://barbearia_user:TROQUE_A_SENHA@localhost:5435/barbearia
SECRET_KEY=TROQUE_POR_UMA_CHAVE_ALEATORIA_LONGA
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
# WhatsApp (usado só na Etapa 9)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# Segurança / infraestrutura
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Opcional: banco separado só para testes (veja o README de testes)
# TEST_DATABASE_URL=postgresql+psycopg://barbearia_user:SENHA@localhost:5435/barbearia_test

# Login com Google (opcional). Crie um "ID do cliente OAuth" do tipo Aplicativo da Web no Google Cloud Console.
GOOGLE_CLIENT_ID=

# Redefinição de senha por e-mail
FRONTEND_URL=http://localhost:5173
# off = não envia | console = imprime o e-mail no terminal da API (só para testar) | smtp = envia de verdade
MAIL_MODE=off
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Avisos de novos cadastros pelo Telegram (opcional; veja docs/telegram.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Localização aproximada pelo IP. {ip} é substituído. Deixe vazio para desligar a consulta externa.
GEOIP_URL=https://ipapi.co/{ip}/json/

# Nome do negócio (aparece nos e-mails e mensagens)
BUSINESS_NAME=Agenda

# Bot do CLIENTE no Telegram (um bot DIFERENTE do bot de avisos do dono; veja docs/bot-cliente.md)
CUSTOMER_BOT_TOKEN=
BOT_BOOKING_DAYS=14
BOT_SESSION_MINUTES=30

# SÓ PARA TESTES: aceita telefone digitado no Telegram (sem confirmar identidade). Deixe false em produção.
BOT_ALLOW_TYPED_PHONE=false

# Lembrete ao cliente (bot): X horas antes de atendimento confirmado; "chegue Y minutos antes"; sem enviar de madrugada
REMINDER_HOURS_BEFORE=4
ARRIVE_EARLY_MINUTES=20
REMINDER_QUIET_START_HOUR=21
REMINDER_QUIET_END_HOUR=7

# Push no app Android (FCM). Caminho do JSON da conta de serviço do Firebase (NUNCA coloque esse arquivo no Git). Vazio = desligado.
FCM_SERVICE_ACCOUNT_FILE=
